rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Role Based Access Control
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'super_admin' || 
        request.auth.token.role == 'super_admin'
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        getUserData().role == 'super_admin' ||
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'super_admin'
      );
    }
    
    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }
    
    function isOwnStudent(studentId) {
      return isAuthenticated() && getUserData().studentId == studentId;
    }

    // 1. Users & Admins Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isSuperAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // 2. Students Collection
    match /students/{studentId} {
      allow read: if isAdmin() || isOwnStudent(studentId);
      allow create, update, delete: if isAdmin();
    }

    // 3. Fee Schedules & Records
    match /fees/{feeId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == getUserData().studentId);
      allow create, update, delete: if isAdmin();
    }

    // 4. Receipts (Students only see their own available receipts)
    match /receipts/{receiptId} {
      allow read: if isAdmin() || (
        isStudent() && 
        resource.data.studentId == getUserData().studentId && 
        resource.data.availableToStudent == true
      );
      allow create, update, delete: if isAdmin();
    }

    // 5. Attendance Records
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == getUserData().studentId);
      allow create, update, delete: if isAdmin();
    }

    // 6. Announcements (Class/Group matching or 'All')
    match /announcements/{announcementId} {
      allow read: if isAdmin() || (
        isStudent() && (
          resource.data.targetClass == 'All' || 
          resource.data.targetClass == getUserData().class
        )
      );
      allow create, update, delete: if isAdmin();
    }

    // 7. Daily Diary
    match /diary/{diaryId} {
      allow read: if isAdmin() || (
        isStudent() && 
        resource.data.class == getUserData().class && 
        (resource.data.group == 'All' || resource.data.group == getUserData().group)
      );
      allow create, update, delete: if isAdmin();
    }

    // 8. Syllabus Books & Chapters
    match /books/{bookId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    match /chapters/{chapterId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // 9. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.studentId == getUserData().studentId ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.studentId == getUserData().studentId
      );
      allow create, delete: if isAdmin();
    }

    // 10. Audit Logs (Super Admin viewable, written by admins)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit trails
    }

    // 11. System Settings & Academic Years
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
