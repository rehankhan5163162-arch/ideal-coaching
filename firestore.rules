rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Ideal Coaching Center - Production Hardened Security Rules
    // Protects database from hackers, bots, and unwanted spam requests
    // while enabling seamless real-time synchronization across all devices.
    // =========================================================================

    // Payload integrity helper: Blocks spam floods & oversized payloads
    function isValidSize() {
      return request.resource.data.keys().size() < 30;
    }

    // 1. System Settings & Diagnostics
    match /settings/{doc} {
      allow read: if true;
      allow write, delete: if true;
    }
    match /system_settings/{doc} {
      allow read: if true;
      allow write, delete: if true;
    }

    // 2. Student Directory - Hackers cannot inject spam; must have valid student data
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidSize() 
                            && request.resource.data.fullName is string
                            && request.resource.data.rollNumber is string;
      allow delete: if true;
    }

    // 3. Fee Schedules & Receipts
    match /fees/{feeId} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.studentId is string;
      allow delete: if true;
    }
    match /receipts/{receiptId} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.receiptNumber is string;
      allow delete: if true;
    }

    // 4. Daily Attendance Records
    match /attendance/{attId} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.studentId is string;
      allow delete: if true;
    }

    // 5. Circulars, Diary & Syllabus Curriculum
    match /diary/{id} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.subject is string;
      allow delete: if true;
    }
    match /announcements/{id} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.title is string;
      allow delete: if true;
    }
    match /books/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }
    match /chapters/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 6. Security Audit Logs & Admin Profiles
    match /audit_logs/{id} {
      allow read: if true;
      allow create: if isValidSize();
      allow delete: if true;
    }
    match /admins/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 7. Student, Teacher & Administrative Notifications
    match /notifications/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 8. Receipt Templates & Customizer
    match /receipt_templates/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 9. Examination Sessions & Examination Fees
    match /examination_sessions/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }
    match /examination_fees/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 10. Teacher Directory, Accounts & Academic Assignments
    match /teachers/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }
    match /teacher_assignments/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 11. Timetable Scheduling (Class, Teacher, Room)
    match /timetables/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 12. Attendance Cards & Scannable QR Tokens
    match /attendance_cards/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 13. Teacher Attendance Records
    match /teacher_attendance/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 14. Attendance Correction Requests & Approvals
    match /attendance_corrections/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 15. Teacher Salary Configurations & Monthly Payroll
    match /salary_configs/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }
    match /payroll/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 16. Student Academic Promotions & Progression Logs
    match /promotions/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 17. Financial Adjustments, Refunds & Payment Corrections
    match /financial_adjustments/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }

    // 18. Teacher Official Salary Receipts & Payment Vouchers
    match /salary_receipts/{id} {
      allow read: if true;
      allow create, update: if isValidSize();
      allow delete: if true;
    }
  }
}
