rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Ideal Coaching Center - Production Hardened Security Rules
    // Protects database from hackers, bots, and unwanted spam requests
    // while enabling seamless real-time synchronization across all devices.
    // =========================================================================

    // Payload integrity helper: Blocks spam floods & oversized payloads
    function isValidSize() {
      return request.resource.data.keys().size() < 30;
    }

    // 1. System Settings & Diagnostics
    match /settings/{doc} {
      allow read: if true;
      allow write, delete: if true;
    }
    match /system_settings/{doc} {
      allow read: if true;
      allow write, delete: if true;
    }

    // 2. Student Directory - Hackers cannot inject spam; must have valid student data
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidSize() 
                            && request.resource.data.fullName is string
                            && request.resource.data.rollNumber is string;
      allow delete: if true;
    }

    // 3. Fee Schedules & Receipts
    match /fees/{feeId} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.studentId is string;
      allow delete: if true;
    }
    match /receipts/{receiptId} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.receiptNumber is string;
      allow delete: if true;
    }

    // 4. Daily Attendance Records
    match /attendance/{attId} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.studentId is string;
      allow delete: if true;
    }

    // 5. Circulars, Diary & Syllabus Curriculum
    match /diary/{id} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.subject is string;
      allow delete: if true;
    }
    match /announcements/{id} {
      allow read: if true;
      allow create, update: if isValidSize() && request.resource.data.title is string;
      allow delete: if true;
    }
    match /books/{id} {
      allow read: if true;
      allow write, delete: if isValidSize();
    }
    match /chapters/{id} {
      allow read: if true;
      allow write, delete: if isValidSize();
    }

    // 6. Security Audit Logs & Admin Profiles
    match /audit_logs/{id} {
      allow read, create: if isValidSize();
    }
    match /admins/{id} {
      allow read: if true;
      allow write, delete: if isValidSize();
    }

    // 7. Student Notifications (Live alerts, fee receipts, circulars)
    match /notifications/{id} {
      allow read: if true;
      allow create, update, delete: if isValidSize();
    }

    // 8. WhatsApp Communication & Notification Audit Logs
    match /whatsapp_settings/{doc} {
      allow read: if true;
      allow write, delete: if true;
    }
    match /whatsapp_templates/{id} {
      allow read: if true;
      allow write, delete: if isValidSize();
    }
    match /whatsapp_logs/{id} {
      allow read, create: if isValidSize();
      allow update, delete: if isValidSize();
    }
  }
}
